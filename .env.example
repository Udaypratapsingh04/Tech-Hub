# Copy this file to ".env" and adjust. Every value is optional in development.

# "development" (default) or "production"
APP_ENV=development

# Long random string used to sign login sessions. If you leave it out, one is
# generated once and stored in instance/.secret_key.
# SECRET_KEY=change-me

# The first admin account is created automatically if no admin exists yet.
ADMIN_EMAIL=admin@techhub.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Store Admin

# Store rules (amounts in rupees)
# FREE_SHIPPING_THRESHOLD=5000
# SHIPPING_FEE=99
# MAX_QTY_PER_ITEM=10

# Where the SQLite file lives (default: instance/techhub.db)
# DATABASE_PATH=instance/techhub.db

# Set to true when serving over HTTPS so the session cookie is marked Secure
# (automatic when APP_ENV=production)
# COOKIE_SECURE=true
